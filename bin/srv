#!/usr/bin/env python3
"""srv — manage compose apps in srv/apps/<app>, with data in srv/data/<app>"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

SETUP_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SETUP_DIR))
import config  # noqa: E402

SRV_ROOT = Path(getattr(config, "SRV_ROOT", "~/srv")).expanduser()
TZ = getattr(config, "TZ", "Europe/Berlin")
APPS_DIR = SRV_ROOT / "apps"
DATA_DIR = SRV_ROOT / "data"
BACKUP_DIR = SRV_ROOT / "backups"
BACKUP_KEEP_DAYS = 14
# The portal (no Docker access) asks for updates by writing here; see process_requests()
PORTAL_DATA = DATA_DIR / "portal"
REQUESTS_DIR = PORTAL_DATA / "requests"
os.environ["TZ"] = TZ
os.environ["PATH"] = f"{Path.home()}/.orbstack/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:" + os.environ.get("PATH", "")

USAGE = f"""Usage: srv <command> [app]

  list              List apps in {APPS_DIR}
  up      [app]     Start one app, or all
  down    [app]     Stop one app, or all
  restart [app]     Restart one app, or all
  update  [app]     Pull new images and recreate
  ps                Running containers
  logs    <app>     Follow logs
  new     <app>     Create apps/<app>/compose.yml and data/<app>/
  prune             Remove unused images
  backup  [app]     Run apps/<app>/backup.sh into {BACKUP_DIR}/<app>, keep {BACKUP_KEEP_DAYS} days
  process-requests  Update apps the portal asked for (run by a LaunchAgent)
  auto-update       Update apps with auto-update enabled in the portal (nightly)
  setup   [step..]  Re-run setup steps (e.g. 'srv setup power')

In compose files use ${{DATA}} for the app's data folder and ${{TZ}} for the timezone.
"""

COMPOSE_NAMES = ("compose.yaml", "compose.yml", "docker-compose.yaml", "docker-compose.yml")


def compose_file(d):
    for name in COMPOSE_NAMES:
        f = d / name
        if f.is_file():
            return f
    return None


def apps():
    if not APPS_DIR.is_dir():
        return
    for d in sorted(APPS_DIR.iterdir()):
        if d.is_dir() and compose_file(d):
            yield d.name


def wait_docker():
    for i in range(150):
        if subprocess.run(["docker", "info"], capture_output=True).returncode == 0:
            return
        if i == 0:
            subprocess.run(["open", "-ga", "OrbStack"], capture_output=True)
        time.sleep(2)
    print("Docker engine not available (is OrbStack running?)", file=sys.stderr)
    sys.exit(1)


def run(name, *args):
    d = APPS_DIR / name
    f = compose_file(d)
    if not f:
        print(f"No compose file in {d}", file=sys.stderr)
        return False
    (DATA_DIR / name).mkdir(parents=True, exist_ok=True)
    print(f"── {name}: docker compose {' '.join(args)}")
    env = {**os.environ, "DATA": str(DATA_DIR / name)}
    return subprocess.run(["docker", "compose", "-f", str(f), *args], cwd=d, env=env).returncode == 0


def for_each(target, *args):
    if target:
        run(target, *args)
    else:
        for a in apps():
            if not run(a, *args):
                print(f"!! {a} failed", file=sys.stderr)


def backup(name):
    script = APPS_DIR / name / "backup.sh"
    if not script.is_file():
        return True
    out = BACKUP_DIR / name
    out.mkdir(parents=True, exist_ok=True)
    print(f"── {name}: backup.sh -> {out}")
    env = {**os.environ, "DATA": str(DATA_DIR / name), "BACKUP": str(out)}
    if subprocess.run(["/bin/sh", str(script)], cwd=script.parent, env=env).returncode != 0:
        return False
    cutoff = time.time() - BACKUP_KEEP_DAYS * 86400
    for f in out.iterdir():
        if f.is_file() and f.stat().st_mtime < cutoff:
            f.unlink()
    return True


def update(name):
    """Pull and recreate one app, recording the result for the portal to show."""
    status_file = PORTAL_DATA / "updates.json"

    def record(state):
        try:
            status = json.loads(status_file.read_text())
        except (OSError, ValueError):
            status = {}
        status[name] = {"state": state, "at": int(time.time())}
        tmp = status_file.with_suffix(".tmp")
        tmp.write_text(json.dumps(status, indent=2))
        tmp.replace(status_file)

    record("running")
    good = run(name, "pull") and run(name, "up", "-d", "--remove-orphans")
    record("ok" if good else "failed")
    return good


def process_requests():
    # Request files come from the LAN-facing portal: only their names are used, and only if they are a known app
    known = set(apps())
    for f in sorted(REQUESTS_DIR.glob("*")) if REQUESTS_DIR.is_dir() else []:
        f.unlink()
        if f.name in known:
            update(f.name)
        else:
            print(f"!! ignoring request for unknown app {f.name!r}", file=sys.stderr)


def auto_update():
    try:
        wanted = json.loads((PORTAL_DATA / "autoupdate.json").read_text())
    except (OSError, ValueError):
        return
    for name in sorted(set(apps()) & set(wanted if isinstance(wanted, list) else [])):
        update(name)


def new_app(name):
    d = APPS_DIR / name
    if d.exists():
        print(f"{d} already exists", file=sys.stderr)
        sys.exit(1)
    d.mkdir(parents=True)
    (DATA_DIR / name).mkdir(parents=True, exist_ok=True)
    (d / "compose.yml").write_text(f"""services:
  {name}:
    image: nginx:alpine            # <- change me
    container_name: {name}
    restart: unless-stopped
    ports:
      - "8081:80"                  # host:container (reachable on your LAN)
    volumes:
      - ${{DATA}}/html:/usr/share/nginx/html
    environment:
      - TZ=${{TZ}}
""")
    (d / ".env").write_text(f"DATA={DATA_DIR / name}\nTZ={TZ}\n")
    print(f"Created {d / 'compose.yml'} (data: {DATA_DIR / name})")
    print(f"Edit it, then: srv up {name}")


def main(argv):
    cmd = argv[0] if argv else ""
    arg = argv[1] if len(argv) > 1 else ""

    if cmd == "list":
        for a in apps():
            print(a)
    elif cmd == "up":
        wait_docker(); for_each(arg, "up", "-d", "--remove-orphans")
    elif cmd == "down":
        wait_docker(); for_each(arg, "down")
    elif cmd == "restart":
        wait_docker(); for_each(arg, "restart")
    elif cmd == "update":
        wait_docker(); for_each(arg, "pull"); for_each(arg, "up", "-d", "--remove-orphans")
    elif cmd == "ps":
        wait_docker()
        subprocess.run(["docker", "ps", "--format", "table {{.Names}}\t{{.Status}}\t{{.Ports}}"])
    elif cmd == "logs":
        if not arg:
            print(USAGE, end=""); sys.exit(1)
        wait_docker(); run(arg, "logs", "-f", "--tail", "100")
    elif cmd == "prune":
        wait_docker()
        subprocess.run(["docker", "image", "prune", "-af"])
    elif cmd == "backup":
        wait_docker()
        for a in [arg] if arg else apps():
            if not backup(a):
                print(f"!! {a} backup failed", file=sys.stderr)
    elif cmd == "process-requests":
        wait_docker(); process_requests()
    elif cmd == "auto-update":
        wait_docker(); auto_update()
    elif cmd == "setup":
        os.execv(sys.executable, [sys.executable, str(SETUP_DIR / "setup.py"), *argv[1:]])
    elif cmd == "new":
        if not arg:
            print(USAGE, end=""); sys.exit(1)
        new_app(arg)
    elif cmd in ("", "-h", "--help", "help"):
        print(USAGE, end="")
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print(USAGE, end="")
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
